# Copy to .env and replace every value before starting Compose.
HIREFLOW_POSTGRES_PASSWORD=replace-with-a-random-postgres-password
HIREFLOW_APP_DATABASE_PASSWORD=replace-with-a-different-random-app-password
HIREFLOW_RABBITMQ_PASSWORD=replace-with-a-random-rabbitmq-password
HIREFLOW_JWT_SECRET=replace-with-at-least-32-random-bytes
HIREFLOW_GRAFANA_ADMIN_PASSWORD=replace-with-a-random-grafana-password
HIREFLOW_BIND_ADDRESS=127.0.0.1
HIREFLOW_ALLOWED_HOSTS=localhost,127.0.0.1
HIREFLOW_LIST_CACHE_TTL_SECONDS=60
