# Copy to .env and replace every value before starting Compose.
HIREFLOW_POSTGRES_PASSWORD=replace-with-a-random-postgres-password
HIREFLOW_APP_DATABASE_PASSWORD=replace-with-a-different-random-app-password
HIREFLOW_RABBITMQ_PASSWORD=replace-with-a-random-rabbitmq-password
HIREFLOW_JWT_SECRET=replace-with-at-least-32-random-bytes
# Optional rolling-key mode. Keep the previous key during the access-token overlap window.
# HIREFLOW_JWT_KEYS={"2026-11":"replace-with-32-plus-bytes","2027-01":"replace-with-32-plus-bytes"}
# HIREFLOW_JWT_ACTIVE_KEY_ID=2027-01
HIREFLOW_REFRESH_TOKEN_DAYS=14
# Local HTTP only. Production Compose forces Secure cookies.
HIREFLOW_COOKIE_SECURE=false
HIREFLOW_GRAFANA_ADMIN_PASSWORD=replace-with-a-random-grafana-password
HIREFLOW_BIND_ADDRESS=127.0.0.1
HIREFLOW_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave empty for direct access. In production, list only the ingress proxy CIDRs.
HIREFLOW_TRUSTED_PROXIES=
HIREFLOW_LIST_CACHE_TTL_SECONDS=60
HIREFLOW_SMTP_SENDER=HireFlow <no-reply@hireflow.local>
HIREFLOW_SMTP_TIMEOUT_SECONDS=5
HIREFLOW_EMAIL_MAX_ATTEMPTS=3
